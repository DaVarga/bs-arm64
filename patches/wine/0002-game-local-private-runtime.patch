diff --git a/tools/makedep.c b/tools/makedep.c
index a4ed58b..370fc77 100644
--- a/tools/makedep.c
+++ b/tools/makedep.c
@@ -3676,7 +3676,11 @@ static void output_module( struct makefile *make, unsigned int arch )
