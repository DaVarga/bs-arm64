-    if (arch) output_filename( "-Wl,--wine-builtin" );
+    /* These game-local runtime DLLs must load from the application directory.
+     * A builtin marker would redirect them to Proton's unpatched copies. */
+    if (arch && strcmp( module, "ucrtbs64.dll" ) &&
+        strcmp( module, "vcruntime140.dll" ) && strcmp( module, "msvcp140.dll" ))
+        output_filename( "-Wl,--wine-builtin" );
     if (!make->is_exe) output_filename( "-shared" );
     if (spec_file)
     {
